{
  "name": "@sphynxoid/stepwise",
  "version": "0.3.0",
  "description": "React hooks and components for interactive explainers: step-through algorithm players, guided product tours, scroll-driven lessons and glossary tooltips, all on one cursor.",
  "license": "MIT",
  "author": "The Sphynx <jmail.hamza@gmail.com>",
  "homepage": "https://github.com/TheSphynxoid/stepwise#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheSphynxoid/stepwise.git"
  },
  "bugs": "https://github.com/TheSphynxoid/stepwise/issues",
  "keywords": [
    "react",
    "react-hooks",
    "explorable-explanations",
    "interactive-explainer",
    "algorithm-visualization",
    "step-player",
    "stepper",
    "walkthrough",
    "guided-tour",
    "product-tour",
    "onboarding",
    "scrollytelling",
    "scroll-driven",
    "chapters",
    "glossary",
    "tooltip",
    "visualization",
    "education",
    "headless",
    "tailwind",
    "shadcn"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/gsap": {
      "types": "./dist/adapters/gsap.d.ts",
      "import": "./dist/adapters/gsap.js"
    },
    "./adapters/driver-js": {
      "types": "./dist/adapters/driver-js.d.ts",
      "import": "./dist/adapters/driver-js.js"
    },
    "./adapters/scroll": {
      "types": "./dist/adapters/scroll.d.ts",
      "import": "./dist/adapters/scroll.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "./dist/adapters/driver-js.js",
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build",
    "clean": "rimraf dist",
    "release": "npm publish --access public",
    "bump": "npm version"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "driver.js": ">= 1.0.0",
    "gsap": ">= 3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "driver.js": {
      "optional": true
    },
    "gsap": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
