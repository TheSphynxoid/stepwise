{
  "name": "@sphynx/stepwise",
  "version": "0.1.0",
  "description": "A kit for interactive, narrated, step-driven visualizations — one primitive (useSteps) at every scale.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external react --external react-dom --external driver.js --external gsap",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "driver.js": ">= 1.0.0",
    "gsap": ">= 3.0.0"
  },
  "peerDependenciesMeta": {
    "driver.js": { "optional": true },
    "gsap": { "optional": true }
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
