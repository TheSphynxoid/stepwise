{
  "name": "@sphynxoid/stepwise",
  "version": "0.1.0",
  "description": "A kit for interactive, narrated, step-driven visualizations — one primitive (useSteps) at every scale.",
  "license": "MIT",
  "author": "The Sphynx <jmail.hamza@gmail.com>",
  "homepage": "https://github.com/TheSphynxoid/stepwise#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheSphynxoid/stepwise.git"
  },
  "bugs": "https://github.com/TheSphynxoid/stepwise/issues",
  "keywords": [
    "react",
    "hooks",
    "step",
    "player",
    "tour",
    "guided-tour",
    "scrollytelling",
    "chapters",
    "visualization",
    "interactive",
    "narrated",
    "glossary",
    "tailwind"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/gsap": {
      "types": "./dist/adapters/gsap.d.ts",
      "import": "./dist/adapters/gsap.js"
    },
    "./adapters/driver-js": {
      "types": "./dist/adapters/driver-js.d.ts",
      "import": "./dist/adapters/driver-js.js"
    },
    "./adapters/scroll": {
      "types": "./dist/adapters/scroll.d.ts",
      "import": "./dist/adapters/scroll.js"
    }
  },
  "sideEffects": [
    "./dist/adapters/driver-js.js"
  ],
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build",
    "clean": "rimraf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "driver.js": ">= 1.0.0",
    "gsap": ">= 3.0.0"
  },
  "peerDependenciesMeta": {
    "driver.js": { "optional": true },
    "gsap": { "optional": true }
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
